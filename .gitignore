# Build output and editor state
bin/
obj/
.vs/
*.suo
*.userprefs

# VIGIL.csproj.user is tracked on purpose: it tells Visual Studio which files
# open in the designer. See "Windows Forms rules" in AGENTS.md.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Downloaded data, the catalogue and the results cache. These live on the
# cloud bucket or a local disk, never in the repository.
data/
python/data/
# The app's Data folder holds code. Without this line, data/ above hides it on Windows, where matching ignores case.
!VIGIL/VIGIL/Data/
*.nc
*.nc4
*.hdf
*.h5
*.he5
# GPM IMERG files end in .HDF5. Both cases are listed, because matching is case-sensitive on Linux.
*.hdf5
*.HDF5
*.zarr/
*.tif
*.tiff

# Credentials. Nothing here is ever committed.
.env
.env.*
.netrc
_netrc
*.pem
*.key
credentials*
.aws/
urs_cookies*

# Planning files that stay on the lead's machine
Project_Brief_v1.pdf
Screenshot*.png
event-day*.png

# Operating system clutter
Thumbs.db
desktop.ini
.DS_Store

# The C# Data/ folder is source code. On Windows the data/ rule above matches it too, because
# file names there ignore case, so it is let back in here.
!/VIGIL/VIGIL/Data/

# The web viewer: installed packages, build output, and its run-time copies of the fixture
# (scripts/copy-fixture.mjs makes them from contract/fixture/).
web/node_modules/
web/dist/
web/public/snapshot.json
web/public/ask.json
