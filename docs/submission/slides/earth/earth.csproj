<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws the cover slide's Earth with the app's own globe. It loads the app's build, so build VIGIL first. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Where the app was built. Pass -p:VigilBuild=<folder> when it was built somewhere else. -->
    <VigilBuild Condition="'$(VigilBuild)' == ''">..\..\..\..\VIGIL\VIGIL\bin\Debug\net8.0-windows</VigilBuild>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VIGIL">
      <HintPath>$(VigilBuild)\VIGIL.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
